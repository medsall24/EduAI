generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  categories  Category[]
  enrollments Enrollment[]
  formations  Formation[]
  lessons     Lesson[]
  modules     Module[]
  resources   Resource[]
  roles       Role[]
  users       User[]
  progress    Progress[]
  quizzes     Quiz[]
  questions   Question[]
  options     Option[]
  quizAttempts  QuizAttempt[]
  quizAnswers   QuizAnswer[] @relation("TenantQuizAnswers")
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            String       @id @default(uuid())
  tenantId      String?
  roleId        String?
  systemRole    SystemRole?
  firstName     String
  lastName      String
  email         String       @unique
  passwordHash  String
  isActive      Boolean      @default(true)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  enrollments   Enrollment[]
  formations    Formation[]
  sessions      Session[]
  progress      Progress[]
  quizAttempts  QuizAttempt[]

  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role?        @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formations  Formation[]

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@unique([tenantId, id])
}

model Formation {
  id           String          @id @default(uuid())
  tenantId     String
  categoryId   String
  formateurId  String
  title        String
  slug         String
  description  String?
  thumbnailUrl String?
  status       FormationStatus @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  enrollments  Enrollment[]
  category     Category        @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formateur    User            @relation(fields: [tenantId, formateurId], references: [tenantId, id])
  modules      Module[]
  progress     Progress[]

  @@unique([tenantId, categoryId, id])
  @@unique([tenantId, slug])
  @@unique([tenantId, id])
}

model Module {
  id          String    @id @default(uuid())
  tenantId    String
  formationId String
  title       String
  description String?
  position    Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lessons     Lesson[]
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formation   Formation @relation(fields: [tenantId, formationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, formationId, id])
  @@unique([tenantId, formationId, position])
}

model Lesson {
  id          String     @id @default(uuid())
  tenantId    String
  moduleId    String
  title       String
  description String?
  type        LessonType
  content     String?
  videoUrl    String?
  duration    Int?
  position    Int
  isPreview   Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module      Module     @relation(fields: [tenantId, moduleId], references: [tenantId, id], onDelete: Cascade)
  resources   Resource[]
  progress    Progress[]
  quizzes     Quiz[]

  @@unique([tenantId, id])
  @@unique([tenantId, moduleId, id])
  @@unique([tenantId, moduleId, position])
}

model Resource {
  id             String       @id @default(uuid())
  tenantId       String
  lessonId       String
  title          String
  description    String?
  type           ResourceType
  url            String
  fileName       String?
  mimeType       String?
  fileSize       Int?
  position       Int
  isDownloadable Boolean      @default(true)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson         Lesson       @relation(fields: [tenantId, lessonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, lessonId, id])
  @@unique([tenantId, lessonId, position])
}

model Enrollment {
  id          String           @id @default(uuid())
  tenantId    String
  formationId String
  userId      String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formation   Formation        @relation(fields: [tenantId, formationId], references: [tenantId, id], onDelete: Cascade)
  user        User             @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, formationId, userId])
  @@unique([tenantId, formationId, id])
}


model Progress {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  formationId String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  formation Formation @relation(fields: [tenantId, formationId], references: [tenantId, id], onDelete: Cascade)
  lesson    Lesson    @relation(fields: [tenantId, lessonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, userId, lessonId])
  @@unique([tenantId, id])
  @@index([tenantId, userId, formationId])
  @@index([tenantId, formationId])
}


model Quiz {
  id           String        @id @default(uuid())
  tenantId     String
  lessonId     String
  title        String
  description  String?
  duration     Int?
  passingScore Float         @default(50)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson       Lesson        @relation(fields: [tenantId, lessonId], references: [tenantId, id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]

  @@unique([tenantId, id])
  @@unique([tenantId, lessonId, id])
  @@index([tenantId, lessonId])
}



model Question {
  id          String       @id @default(uuid())
  tenantId    String
  quizId      String
  text        String
  type        QuestionType
  points      Float        @default(1)
  position    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz        Quiz         @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  options     Option[]
  answers     QuizAnswer[]

  @@unique([tenantId, id])
  @@unique([tenantId, quizId, id])
  @@unique([tenantId, quizId, position])
  @@index([tenantId, quizId])
}




model Option {
  id          String    @id @default(uuid())
  tenantId    String
  questionId  String
  text        String
  isCorrect   Boolean   @default(false)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [tenantId, questionId], references: [tenantId, id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([tenantId, id])
  @@unique([tenantId, questionId, id])
  @@unique([tenantId, questionId, position])
  @@index([tenantId, questionId])
}


model QuizAttempt {
  id          String    @id @default(uuid())
  tenantId    String
  quizId      String
  userId      String
  score       Float     @default(0)
  percentage  Float     @default(0)
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz        Quiz      @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  user        User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([tenantId, id])
  @@index([tenantId, quizId, userId])
  @@index([tenantId, userId])
}



model QuizAnswer {
  id          String       @id @default(uuid())
  tenantId    String
  attemptId   String
  questionId  String
  optionId    String
  createdAt   DateTime     @default(now())

  tenant      Tenant       @relation("TenantQuizAnswers", fields: [tenantId], references: [id], onDelete: Cascade)
  attempt     QuizAttempt  @relation(fields: [tenantId, attemptId], references: [tenantId, id], onDelete: Cascade)
  question    Question     @relation(fields: [tenantId, questionId], references: [tenantId, id], onDelete: Cascade)
  option      Option       @relation(fields: [tenantId, optionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, attemptId, questionId, optionId])
  @@index([tenantId, attemptId])
  @@index([tenantId, questionId])
  @@index([tenantId, optionId])
}





enum SystemRole {
  SUPER_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum FormationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  TEXT
  VIDEO
  DOCUMENT
  MIXED
}

enum ResourceType {
  PDF
  DOCUMENT
  IMAGE
  VIDEO
  LINK
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}







